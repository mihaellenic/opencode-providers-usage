{
  "name": "opencode-providers-usage",
  "version": "0.1.0",
  "license": "MIT",
  "author": "Mihael Lenic",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mihaellenic/opencode-providers-usage.git"
  },
  "type": "module",
  "main": "./dist/index.js",
  "packageManager": "bun@1.4.4",
  "engines": {
    "bun": "1.4.4"
  },
  "files": [
    "dist/",
    "index.js",
    "tui.js",
    "rpc.js"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "typecheck": "tsc --noEmit --jsx preserve",
    "lint": "biome check src tests",
    "test": "bun test",
    "build": "bun scripts/build.ts",
    "setup": "git config core.hooksPath githooks",
    "prepack": "bun run build"
  },
  "exports": {
    ".": "./dist/index.js",
    "./server": "./dist/index.js",
    "./tui": "./dist/tui.js",
    "./rpc": "./dist/rpc.js"
  },
  "dependencies": {
    "@opencode/plugin": "2.1.4"
  },
  "peerDependencies": {
    "@opencode/theme": "2.1.4",
    "@opentui/core": ">=0.6.8",
    "@opentui/solid": ">=0.6.8",
    "solid-js": ">=1.9.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.3",
    "@opentui/solid": "0.6.8",
    "@types/bun": "1.4.4",
    "typescript": "7.0.2"
  }
}
