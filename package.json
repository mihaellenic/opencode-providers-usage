{
  "name": "opencode-providers-usage",
  "version": "0.1.0",
  "license": "MIT",
  "author": "Mihael Lenic",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mihaellenic/opencode-providers-usage.git"
  },
  "type": "module",
  "main": "./dist/index.js",
  "packageManager": "bun@1.4.4",
  "engines": {
    "bun": "1.4.4"
  },
  "files": [
    "dist/",
    "index.js",
    "tui.js",
    "rpc.js"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "typecheck": "tsc --noEmit --jsx preserve && tsc -p tsconfig.gui.json",
    "lint": "biome check src tests",
    "test": "bun test && bun run test:gui",
    "build": "bun scripts/build.ts",
    "setup": "git config core.hooksPath githooks",
    "prepack": "bun run build",
    "test:gui": "bun test --conditions browser --preload ./tests/gui/dom-setup.ts ./tests/gui/*.gui.*"
  },
  "exports": {
    ".": "./dist/index.js",
    "./server": "./dist/index.js",
    "./tui": "./dist/tui.js",
    "./rpc": "./dist/rpc.js",
    "./gui-experimental": "./dist/gui-experimental.cjs"
  },
  "dependencies": {
    "@opencode/plugin": "2.2.0"
  },
  "peerDependencies": {
    "@opencode/theme": "2.2.0",
    "@opentui/core": ">=0.6.8",
    "@opentui/solid": ">=0.6.8",
    "solid-js": ">=1.9.0"
  },
  "devDependencies": {
    "@babel/core": "7.29.7",
    "@babel/preset-typescript": "7.27.1",
    "@biomejs/biome": "2.6.3",
    "@happy-dom/global-registrator": "21.0.4",
    "@opentui/solid": "0.6.8",
    "@types/bun": "1.4.4",
    "babel-preset-solid": "1.9.12",
    "happy-dom": "21.0.4",
    "solid-js": "1.9.12",
    "typescript": "7.0.2",
    "vite": "7.3.7",
    "vite-plugin-solid": "2.11.14"
  },
  "overrides": {
    "seroval": "1.6.8"
  }
}
